{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Notify",
  "version": "0.0.1",
  "identifier": "io.echelon.desktop-notify.tauri",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main", "title": "Desktop Notify", "width": 540, "height": 480,
      "minWidth": 360, "minHeight": 280, "decorations": false,
      "transparent": true, "shadow": true, "resizable": true,
      "visible": false, "center": true, "alwaysOnTop": true,
      "visibleOnAllWorkspaces": true, "skipTaskbar": true
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true, "targets": ["app"], "category": "Productivity",
    "shortDescription": "Persistent agent alerts in your tray",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "11.0", "infoPlist": "Info.plist" }
  }
}
